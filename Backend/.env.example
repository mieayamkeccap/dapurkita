# ===== Server =====
# PORT tidak perlu diisi saat deploy: Render memberi nilainya sendiri.
PORT=8000

# ===== Database MySQL =====
# Di lokal (Laragon): DB_HOST=localhost, DB_PORT=3306, DB_SSL=false
# Di Aiven: isi host & port dari halaman service, lalu DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dapurkita_db

# Wajib true kalau host database mewajibkan TLS (Aiven)
DB_SSL=false

# Isi salah satu bentuk berikut, hanya kalau DB_SSL=true:
#  - isi berkas ca.pem apa adanya (baris BEGIN/END CERTIFICATE ikut disalin)
#  - atau isi berkas ca.pem yang sudah diubah ke base64
# Kalau dibiarkan kosong, koneksi tetap terenkripsi tetapi sertifikat server
# tidak diverifikasi.
DB_CA_CERT=

# ===== Keamanan =====
# WAJIB diganti dengan kunci baru saat deploy. Jangan memakai kunci yang sama
# dengan lokal, karena token lokal akan ikut berlaku di server.
JWT_SECRET=ganti-dengan-kunci-rahasia

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
